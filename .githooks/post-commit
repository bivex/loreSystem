#!/usr/bin/env bash
# git-version post-commit hook
# Automatically bumps VERSION.txt after non-release commits

# Configuration
AUTO_BUMP=${AUTO_BUMP:-true}

find_git_version_cmd() {
    local candidate=""

    for candidate in \
        "${GIT_VERSION_CMD:-}" \
        "$HOME/.local/bin/git-version" \
        "/usr/local/bin/git-version" \
        "/opt/homebrew/bin/git-version"
    do
        if [ -n "$candidate" ] && [ -x "$candidate" ]; then
            echo "$candidate"
            return 0
        fi
    done

    candidate=$(command -v git-version 2>/dev/null || true)
    if [ -n "$candidate" ] && [ -x "$candidate" ]; then
        case "$candidate" in
            */git-core/git-version)
                ;;
            *)
                echo "$candidate"
                return 0
                ;;
        esac
    fi

    return 1
}

clean_version_output() {
    printf '%s' "$1" | tr -d '\033' | sed 's/\[[0-9;]*m//g' | tr -d '[:cntrl:]'
}

is_valid_version() {
    local version="${1#v}"
    [[ "$version" =~ ^[0-9]{4}\.[0-9]{2}\.[0-9]{2}(-[0-9]+)?$ ]]
}

version_date() {
    printf '%s' "${1#v}" | cut -d'-' -f1
}

version_increment() {
    local version="${1#v}"
    local increment
    increment=$(printf '%s' "$version" | cut -d'-' -f2 -s)
    printf '%s' "${increment:-0}"
}

version_ge() {
    local left="$1"
    local right="$2"
    local left_date right_date left_inc right_inc

    left_date=$(version_date "$left")
    right_date=$(version_date "$right")
    left_inc=$(version_increment "$left")
    right_inc=$(version_increment "$right")

    if [ "$left_date" \> "$right_date" ]; then
        return 0
    fi

    if [ "$left_date" \< "$right_date" ]; then
        return 1
    fi

    [ "$left_inc" -ge "$right_inc" ]
}

next_after_version() {
    local current="$1"
    local current_date current_inc today

    current_date=$(version_date "$current")
    current_inc=$(version_increment "$current")
    today=$(date -u +"%Y.%m.%d")

    if [ "$current_date" \> "$today" ] || [ "$current_date" = "$today" ]; then
        printf 'v%s-%s\n' "$current_date" "$((current_inc + 1))"
    else
        printf 'v%s\n' "$today"
    fi
}

is_release_files_only_commit() {
    local changed_files
    changed_files=$(git diff-tree --no-commit-id --name-only -r HEAD 2>/dev/null || true)

    [ -n "$changed_files" ] || return 1

    while IFS= read -r file; do
        case "$file" in
            VERSION.txt|CHANGELOG.md)
                ;;
            *)
                return 1
                ;;
        esac
    done <<< "$changed_files"

    return 0
}

if [ "$AUTO_BUMP" != "true" ]; then
    exit 0
fi

REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
cd "$REPO_ROOT" || exit 0

LAST_COMMIT=$(git log -1 --pretty=format:"%s")
if [[ "$LAST_COMMIT" =~ ^chore:\ release ]]; then
    exit 0
fi

if is_release_files_only_commit; then
    exit 0
fi

GIT_VERSION_CMD=$(find_git_version_cmd || true)
if [ -z "$GIT_VERSION_CMD" ]; then
    exit 0
fi

CURRENT_VERSION=$(clean_version_output "$("$GIT_VERSION_CMD" -q current 2>/dev/null || true)")
NEXT_VERSION=$(clean_version_output "$("$GIT_VERSION_CMD" -q next 2>/dev/null | head -1 || true)")
TARGET_VERSION=""

if is_valid_version "$CURRENT_VERSION" && is_valid_version "$NEXT_VERSION"; then
    if version_ge "$CURRENT_VERSION" "$NEXT_VERSION"; then
        TARGET_VERSION=$(next_after_version "$CURRENT_VERSION")
    else
        TARGET_VERSION="$NEXT_VERSION"
    fi
elif is_valid_version "$NEXT_VERSION"; then
    TARGET_VERSION="$NEXT_VERSION"
elif is_valid_version "$CURRENT_VERSION"; then
    TARGET_VERSION=$(next_after_version "$CURRENT_VERSION")
fi

if is_valid_version "$TARGET_VERSION" && [ "$TARGET_VERSION" != "$CURRENT_VERSION" ]; then
    printf '%s\n' "$TARGET_VERSION" > VERSION.txt
    git add VERSION.txt 2>/dev/null || true
fi

exit 0
